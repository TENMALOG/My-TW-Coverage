---
import '../styles/global.css';
// Vite resolves these build-time branches; an unset style imports no theme.
if (import.meta.env.PUBLIC_STYLE === 'editorial') {
  await import('../styles/themes/editorial.css');
} else if (import.meta.env.PUBLIC_STYLE === 'terminal') {
  await import('../styles/themes/terminal.css');
} else if (import.meta.env.PUBLIC_STYLE === 'arc') {
  await import('../styles/themes/arc.css');
}
import { researchScope, directoryNote } from '../lib/research-scope.js';
import { serializeJsonForHtml } from '../lib/html.js';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = `${researchScope}。${directoryNote}公司頁每條事實都附來源文件頁碼。用卡片、圖表和公司速覽影片看懂公司在做什麼。`,
  ogType = 'website',
  ogImage = null,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const img = ogImage ? new URL(ogImage, Astro.site).href : null;
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '股.tw 研究室',
  url: Astro.site?.href,
  inLanguage: 'zh-Hant-TW',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL('/search/', Astro.site).href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => currentPath === (href.replace(/\/+$/, '') || '/') || (href !== '/' && currentPath.startsWith(href));
const mobileTabs = [
  { href: '/', label: '首頁', icon: 'M3 10.5 12 3l9 7.5M5 9v12h5v-7h4v7h5V9' },
  { href: '/search/', label: '搜尋', icon: 'M20.5 20.5 16 16M18 10.5a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z' },
  { href: '/map/', label: '地圖', icon: 'm3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16' },
  { href: '/screen/', label: '篩選', icon: 'M3 6h18M3 12h18M3 18h18M8 3v6m8 0v6m-8 0v6' },
  { href: '/watch/', label: '觀察', icon: 'm12 3 2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-3-5.6 3 1.1-6.3L3 9.6l6.2-.9L12 3Z' },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}｜股.tw 研究室</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={`${title}｜股.tw 研究室`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="股.tw 研究室" />
  <meta property="og:locale" content="zh_TW" />
  <meta name="theme-color" content="#FF573F" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {img && <meta property="og:image" content={img} />}
  {img && <meta property="og:image:width" content="1200" />}
  {img && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" is:inline set:html={serializeJsonForHtml(websiteJsonLd)} />
  {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonForHtml(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;900&family=Noto+Serif+TC:wght@600;700&family=Roboto+Mono:wght@500;700&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <header class="top"><div class="in">
    <a class="logo" href="/">股<b>.</b>tw<span class="logo-sub"> 研究室</span></a>
    <span class="sp"></span>
    <nav class="desktop-nav" aria-label="主要導覽">
      <a class="iconbtn" href="/search/" aria-label="搜尋" aria-current={isCurrent('/search/') ? 'page' : undefined}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={mobileTabs[1].icon} /></svg></a>
      <a class="iconbtn" href="/screen/" aria-current={isCurrent('/screen/') ? 'page' : undefined}>篩選</a>
      <a class="iconbtn" href="/map/" aria-current={isCurrent('/map/') ? 'page' : undefined}>地圖</a>
      <a class="iconbtn" href="/watch/" aria-label="我的觀察清單" aria-current={isCurrent('/watch/') ? 'page' : undefined}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={mobileTabs[4].icon} /></svg></a>
    </nav>
    <button class="iconbtn" type="button" id="theme" aria-label="切換深淺色模式"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4v16M12 4a8 8 0 0 1 0 16Z" fill="currentColor" /></svg></button>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer class="wrap muted site-footer">
    <p>內容整理自公開資訊觀測站年報、公開說明書與財務資料，公司頁每條事實都附來源文件頁碼，歡迎回查。本站不提供任何個股買賣建議，投資請自行判斷。原專案年報事實評估基準日 2026-10-08；財務快照 2026-10-11（台北時間）。</p>
    <nav class="footer-links" aria-label="網站資訊">
      <a href="/about/">我們怎麼做</a>
      <a href="/paper/">研究報告全文</a>
      <a href="/errata/">抓到錯了？</a>
      <a href="/license/">想引用？看這裡</a>
      <a href="/privacy/">隱私權政策</a>
      <span>經營：Tenmalog 尼奧天馬</span>
    </nav>
  </footer>
  <nav class="bottom-nav" aria-label="主要導覽">
    {mobileTabs.map(({ href, label, icon }) => (
      <a class="iconbtn bottom-tab" href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
        <svg class="tab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
        <span>{label}</span>
      </a>
    ))}
  </nav>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const r = document.documentElement;
      const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      r.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
      window.dispatchEvent(new Event('themechange'));
    });
    // Content stays visible from first paint; scrolling never gates a card.
  </script>
</body>
</html>
