---
import '../styles/global.css';
const { title, description = '每一句都能回查年報的台股產業研究', ogType = 'website' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}｜股.tw 研究室</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={`${title}｜股.tw 研究室`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta name="theme-color" content="#FF573F" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700;900&family=Noto+Serif+TC:wght@700&family=Roboto+Mono:wght@500;700&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <header class="top"><div class="in">
    <a class="logo" href="/">股<b>.</b>tw 研究室</a>
    <span class="sp"></span>
    <a class="iconbtn" href="/search/" aria-label="搜尋">🔍 搜尋</a>
    <button class="iconbtn" id="theme" aria-label="切換深色模式">◐</button>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer class="wrap muted" style="padding-bottom:40px">
    內容整理自公開資訊觀測站年報與財務資料，經逐句查核；不構成投資建議。示範版。
  </footer>
  <script>
    import { animate, inView } from 'motion';
    document.getElementById('theme')?.addEventListener('click', () => {
      const r = document.documentElement;
      const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      r.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
      window.dispatchEvent(new Event('themechange'));
    });
    // 貼紙卡片捲進畫面時「落地」：先掉下來再微微回彈（和 Shorts 的重力動畫同一套語言）
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      inView('.reveal', (el) => {
        animate(el, { opacity: [0, 1], y: [28, 0], rotate: [-1, 0] }, { type: 'spring', bounce: 0.45, duration: 0.7 });
      }, { margin: '0px 0px -10% 0px' });
    }
  </script>
</body>
</html>
