---
// 篩選器：依產業、證交所產業別、營收、年增、毛利率篩選 1,733 家；結果可勾選後送進比較器。資料量小，直接在瀏覽器篩選。
import Base from '../../layouts/Base.astro';
---
<Base title="篩選公司" description="依產業、營收、年增率、毛利率篩選 1,733 家台股上市櫃公司">
  <section class="card">
    <h1 style="font-family:'Noto Serif TC',serif;margin:0 0 8px">篩選公司</h1>
    <form id="f" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end">
      <label>產業<br /><select name="i" class="in"><option value="">全部</option></select></label>
      <label>證交所產業別<br /><select name="m" class="in"><option value="">全部</option></select></label>
      <label>營收至少（億）<br /><input name="rmin" type="number" min="0" step="1" class="in" placeholder="例如 100" /></label>
      <label>毛利率至少（%）<br /><input name="gmin" type="number" step="1" class="in" placeholder="例如 40" /></label>
      <label>營收年增至少（%）<br /><input name="ymin" type="number" step="1" class="in" placeholder="例如 10" /></label>
      <label>排序<br /><select name="s" class="in"><option value="rev">營收高→低</option><option value="gm">毛利率高→低</option><option value="yoy">年增高→低</option></select></label>
    </form>
    <p class="muted" style="margin:10px 0 0">2025 年度合併報表（公開資訊觀測站）；年增率由本站計算。銀行、保險等報表格式不同的公司沒有毛利率。</p>
  </section>
  <p id="count" style="font-weight:900"></p>
  <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="iconbtn" id="cmp" href="/compare/" style="display:none">比較已勾選</a></div>
  <div id="res"></div>
  <style>.in{width:100%;font:inherit;padding:8px 10px;border:2px solid var(--fg);border-radius:12px;background:var(--bg);color:var(--fg)}</style>

  <script>
    import { summary, miniCard, el } from '../../components/tools.js';
    const all = await summary();
    const f = document.getElementById('f');
    const opts = (name, pairs) => f.elements[name].append(...pairs.map(([v, t]) => el('option', { value: v }, t)));
    opts('i', [...new Map(all.map((c) => [c.i, c.in]))].sort((a, b) => a[1].localeCompare(b[1], 'zh-Hant')));
    opts('m', [...new Set(all.map((c) => c.m).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'zh-Hant')).map((m) => [m, m]));
    const picked = new Set();
    const num = (n) => (f.elements[n].value === '' ? null : Number(f.elements[n].value));
    function run() {
      const v = Object.fromEntries(new FormData(f));
      const rmin = num('rmin'), gmin = num('gmin'), ymin = num('ymin');
      let r = all.filter((c) => (!v.i || c.i === v.i) && (!v.m || c.m === v.m)
        && (rmin == null || (c.rev ?? -1) >= rmin) && (gmin == null || (c.gm ?? -1e9) >= gmin) && (ymin == null || (c.yoy ?? -1e9) >= ymin));
      r.sort((a, b) => (b[v.s] ?? -1e9) - (a[v.s] ?? -1e9));
      document.getElementById('count').textContent = `符合 ${r.length} 家` + (r.length > 60 ? '，顯示前 60 家' : '');
      document.getElementById('res').replaceChildren(...r.slice(0, 60).map((c) => miniCard(c,
        el('label', { style: 'display:inline-flex;gap:6px;align-items:center;margin-top:6px;font-size:14px' },
          el('input', { type: 'checkbox', ...(picked.has(c.t) ? { checked: '' } : {}), onchange: (e) => { e.target.checked ? picked.add(c.t) : picked.delete(c.t); upd(); } }), '加入比較（最多 3 家）'))));
    }
    function upd() {
      const a = document.getElementById('cmp');
      a.style.display = picked.size ? '' : 'none';
      a.href = `/compare/?c=${[...picked].slice(0, 3).join(',')}`;
      a.textContent = `比較已勾選（${Math.min(picked.size, 3)}）`;
    }
    f.addEventListener('input', run);
    run();
  </script>
</Base>
